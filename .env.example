# Mẫu các biến môi trường. File .env thật đã được commit sẵn với giá trị demo.
# Sao chép thành .env rồi sửa. Biến nào bỏ trống/không khai báo sẽ dùng giá trị mặc định
# trong larose_be/src/main/resources/application.properties (chỉ phù hợp chạy thử trên máy cá nhân).

MYSQL_ROOT_PASSWORD=12345678

# URL mà TRÌNH DUYỆT truy cập (dùng cho CORS, link trong email, build frontend)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Bí mật ứng dụng - NÊN đổi khi triển khai thật
# JWT_SECRET=
# GEMINI_API_KEY=            # trợ lý ảo (chatbot); để trống thì chatbot báo chưa cấu hình
# MAIL_USERNAME=
# MAIL_PASSWORD=
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
